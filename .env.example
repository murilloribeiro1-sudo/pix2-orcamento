# Chave da fal.ai (https://fal.ai/dashboard/keys)
FAL_KEY=
# Senha do console do apresentador (/show)
ADMIN_PASS=
# Código que vai embutido no QR Code para o público (/pia?c=CODIGO)
EVENT_CODE=parana2026
# URL pública do deploy (usada para montar os links das referências). Ex: https://pix2-orcamento.vercel.app
PUBLIC_URL=
# Opcional: sobrescrever modelos
# IMAGE_MODEL_LOCATION=fal-ai/nano-banana
# IMAGE_MODEL_SELFIE=fal-ai/nano-banana-pro/edit
# VIDEO_MODEL=bytedance/seedance-2.5/reference-to-video
# Opcional: URLs das referências do personagem (separadas por vírgula). Padrão: /refs/*.png do próprio deploy
# REF_CHARACTER_URLS=
# REF_FACE_URL=
# REF_OUTFIT_URL=
